# Copy to .env.local and restart `npm run dev` after changes.

# Where the Vite dev/preview server forwards /api/* requests (the FastAPI analysis API).
API_PROXY_TARGET=http://localhost:8000

# Leave empty to use the proxy above. Set it (e.g. http://10.0.0.5:8000) to call the API directly
# from the browser; the API must then list this page's origin in CORS_ORIGINS.
VITE_API_URL=

# Demo mode for the PDF report button: use /api/threat-report/demo-download instead of generating a live report.
VITE_DEMO_REPORT=false
